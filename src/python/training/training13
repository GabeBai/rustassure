#include <stdio.h>

typedef int (*ArithmeticFn)(int, int);

int add(int a, int b) {
    return a + b;
}

int subtract(int a, int b) {
    return a - b;
}

int multiply(int a, int b) {
    return a * b;
}

int main() {
    int a = 5;
    int b = 10;
    ArithmeticFn funcs[] = {add, subtract, multiply};
    for (int i = 0; i < 3; i++) {
        int result = funcs[i](a, b);
        printf("Result of operation %d: %d\n", i, result);
    }
    return 0;
}


