C code input:

#include <stdio.h>
#include <stdlib.h>

#define MAX_SIZE 10

int ascending(int a, int b) {
    return a - b;
}

int descending(int a, int b) {
    return b - a;
}

void sort(int *arr, int size, int (*cmp)(int, int)) {
    for (int i = 0; i < size - 1; i++) {
        for (int j = i + 1; j < size; j++) {
            if (cmp(arr[i], arr[j]) > 0) {
                int temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }
}

int main() {
    int arr[MAX_SIZE] = {3, 5, 2, 7, 1, 8, 4, 9, 6, 0};
    printf("Original array: ");
    for (int i = 0; i < MAX_SIZE; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    sort(arr, MAX_SIZE, ascending);
    printf("Sorted array in ascending order: ");
    for (int i = 0; i < MAX_SIZE; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    sort(arr, MAX_SIZE, descending);
    printf("Sorted array in descending order: ");
    for (int i = 0; i < MAX_SIZE; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}


Translated to Rust:

const MAX_SIZE: usize = 10;

fn ascending(a: i32, b: i32) -> i32 {
    a - b
}

fn descending(a: i32, b: i32) -> i32 {
    b - a
}

fn sort(arr: &mut [i32], cmp: fn(i32, i32) -> i32) {
    let size = arr.len();
    for i in 0..(size - 1) {
        for j in (i + 1)..size {
            if cmp(arr[i], arr[j]) > 0 {
                arr.swap(i, j);
            }
        }
    }
}

fn main() {
    let mut arr: [i32; MAX_SIZE] = [3, 5, 2, 7, 1, 8, 4, 9, 6, 0];
    println!("Original array: {:?}", arr);

    sort(&mut arr, ascending);
    println!("Sorted array in ascending order: {:?}", arr);

    sort(&mut arr, descending);
    println!("Sorted array in descending order: {:?}", arr);
}
