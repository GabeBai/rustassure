C code input:

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Person {
    char name[50];
    int age;
};

int compare_by_age(const void *a, const void *b) {
    const struct Person *pa = (const struct Person *)a;
    const struct Person *pb = (const struct Person *)b;
    return pa->age - pb->age;
}

int main() {
    struct Person people[3] = {{"Alice", 25}, {"Bob", 30}, {"Charlie", 20}};
    qsort(people, 3, sizeof(struct Person), compare_by_age);
    for (int i = 0; i < 3; i++) {
        printf("%s, %d\n", people[i].name, people[i].age);
    }
    return 0;
}


Translated to Rust:

#[derive(Debug, Eq, PartialEq)]
struct Person {
    name: String,
    age: i32,
}

impl Person {
    fn new(name: &str, age: i32) -> Self {
        Self {
            name: name.to_owned(),
            age,
        }
    }
}

fn compare_by_age(a: &Person, b: &Person) -> std::cmp::Ordering {
    a.age.cmp(&b.age)
}

fn main() {
    let mut people = vec![
        Person::new("Alice", 25),
        Person::new("Bob", 30),
        Person::new("Charlie", 20),
    ];
    people.sort_by(compare_by_age);
    for person in people {
        println!("{:?}", person);
    }
}

