const MAX_SIZE: usize = 10;

fn main() {
    let arr: [i32; MAX_SIZE] = [3, 5, 2, 7, 1, 8, 4, 9, 6, 0];
    let mut max = arr[0];
    for i in 1..MAX_SIZE {
