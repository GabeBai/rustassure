C code input:

#include <stdio.h>

#define MAX_SIZE 10

int main() {
    int arr[MAX_SIZE] = {3, 5, 2, 7, 1, 8, 4, 9, 6, 0};
    int max = arr[0];
    for (int i = 1; i < MAX_SIZE; i++) {
        if (arr[i] > max) {
            max = arr[i];
        }
    }
    printf("The maximum element is %d\n", max);
    return 0;
}


